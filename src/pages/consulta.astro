---
import Base from '../layouts/Base.astro';
import Phero from '../components/Phero.astro';
import Kicker from '../components/Kicker.astro';
import Moldura from '../components/Moldura.astro';
import Momentos from '../components/Momentos.astro';
import Perguntas from '../components/Perguntas.astro';
import Fecho from '../components/Fecho.astro';
import Botao from '../components/Botao.astro';
import { site, wa, profissional } from '../lib/site';
import { ORG_ID, LARISSA_ID, migalhas, schemaLarissa } from '../lib/schema';

const thaina = profissional('thaina');
const julia = profissional('julia');
const comum = [['Avaliação', 'Histórico e avaliação capilar, com tricoscopia de até 200x quando indicada'], ['Exames', 'Solicitados quando a causa pede investigação'], ['Plano', 'Em casa, no consultório ou nos dois']];
const modalidades = [
  {
    classe: 'way--team', selo: 'COM AS TRICOLOGISTAS DA HAIR ZENITH', titulo: 'Consulta Expert',
    texto: 'Uma avaliação individualizada, conduzida por profissionais da nossa equipe, para compreender suas necessidades capilares e orientar os próximos passos.',
    foto: { img: 'tricoscopio-retrato', alt: 'Tricoscópio digital apoiado no couro cabeludo durante a avaliação' },
    linhas: [['Quem conduz', [`${thaina.tratamento} ${thaina.nomeCurto} – Copacabana`, `${julia.tratamento} ${julia.nomeCurto} – Cabo Frio`]], ...comum, ['Valor', 'Informado no agendamento']],
    botao: { href: wa(site.msgEquipe), variante: 'shimmer' as const, texto: 'Agendar Consulta Expert' },
  },
  {
    classe: 'way--founder', selo: 'DIRETAMENTE COM A CEO', titulo: 'Consulta Signature',
    texto: 'Uma experiência personalizada para quem deseja ser atendida diretamente pela fundadora da Hair Zenith, com sua experiência e olhar profissional.',
    foto: { img: 'larissa-blazer', alt: 'Dra. Larissa Pessoa de blazer branco' },
    linhas: [['Quem conduz', 'Dra. Larissa Pessoa, fundadora e CEO da Hair Zenith'], ...comum, ['Valor', 'Diferenciado, informado no agendamento']],
    botao: { href: wa(site.msgLarissa), variante: 'gold' as const, texto: 'Agendar Consulta Signature' },
  },
];
const escolhas = [
  { nome: 'tipo', legenda: '01 • Modalidade de Consulta', opcoes: ['Consulta Expert', 'Consulta Signature'], marcada: 'Consulta Expert' },
  { nome: 'unidade', legenda: '02 • Unidade de Preferência', opcoes: ['Copacabana', 'Cabo Frio', 'Tanto faz'], marcada: 'Copacabana' },
  { nome: 'queixa', legenda: '03 • O que você está percebendo', opcoes: ['Queda de cabelo', 'Calvície', 'Couro cabeludo aparente', 'Fios mais finos', 'Perda de volume', 'Prefiro contar na consulta'], marcada: 'Prefiro contar na consulta' },
  { nome: 'periodo', legenda: '04 • Período Preferencial', opcoes: ['Manhã', 'Tarde', 'Qualquer horário'], marcada: 'Qualquer horário' },
];
const faq = [
  { q: 'Qual a diferença entre a Consulta Expert e a Consulta Signature?', a: 'A filosofia de cuidado é a mesma: histórico, avaliação capilar, exames quando necessários e plano de cuidado. Na Consulta Expert, quem conduz são as tricologistas da Hair Zenith. Na Consulta Signature, quem conduz é a própria Dra. Larissa Pessoa, fundadora e CEO, com agenda própria e valor diferenciado.' },
  { q: 'Quanto custa a consulta?', a: 'Os valores das duas modalidades são informados no agendamento, pelo WhatsApp.' },
  { q: 'O tratamento começa na mesma consulta?', a: 'A consulta é de avaliação e planejamento. O tratamento começa depois, em casa, no consultório ou nos dois, conforme o plano definido.' },
  { q: 'O que levar?', a: 'Exames de sangue recentes, se você tiver, e a lista dos medicamentos e suplementos que usa.' },
  { q: 'Vocês atendem homens e mulheres?', a: 'Sim. A Hair Zenith trata queda e calvície em mulheres e homens.' },
];
const schema = [
  {
    '@type': 'WebPage', url: site.url + '/consulta/', name: 'Consulta de tricologia', inLanguage: 'pt-BR',
    mainEntity: [
      { '@type': 'Service', name: 'Consulta Expert', serviceType: 'Consulta de tricologia', provider: { '@id': ORG_ID }, description: 'Uma avaliação individualizada, conduzida pelas tricologistas da Hair Zenith, para compreender as necessidades capilares e orientar os próximos passos.' },
      { '@type': 'Service', name: 'Consulta Signature', serviceType: 'Consulta de tricologia', provider: { '@id': LARISSA_ID }, description: 'Uma experiência personalizada, diretamente com a Dra. Larissa Pessoa, fundadora e CEO da Hair Zenith.' },
    ],
  },
  migalhas([['Hair Zenith', '/'], ['Consulta', '/consulta/']]),
  schemaLarissa(),
];
---
<Base
  titulo="Consulta de tricologia no Rio de Janeiro: Consulta Expert e Consulta Signature | Hair Zenith"
  descricao="A mesma filosofia de cuidado em duas consultas: a Consulta Expert, com as tricologistas da Hair Zenith, e a Consulta Signature, diretamente com a Dra. Larissa Pessoa. Copacabana e Cabo Frio."
  ativo="consulta"
  schema={schema}
>
  <Phero
    h1="Consulta de tricologia"
    lead="Duas modalidades, um mesmo método. O que muda é quem conduz a sua consulta."
    alto={{ img: 'tela-tricoscopia-retrato', alt: 'Imagem ampliada dos fios na tela durante a tricoscopia' }}
    quadrado={{ img: 'larissa-sentada', alt: 'Dra. Larissa Pessoa sentada em uma poltrona clara' }}
  >
    <Botao href={wa()}>Agendar consulta</Botao><a class="link" href="#h-modalidades">Comparar as modalidades &rarr;</a>
  </Phero>

  <section class="ways wrap grid" aria-labelledby="h-modalidades">
    <div class="ways__head">
      <Kicker data-reveal>MODALIDADES DE ATENDIMENTO</Kicker>
      <h2 id="h-modalidades" data-reveal>A mesma filosofia de cuidado.</h2>
      <p class="ways__intro" data-reveal style="--i:1">Duas formas de viver a experiência Hair Zenith.</p>
    </div>
    {modalidades.map((m) => (
      <article class={`way ${m.classe}`} data-spotlight data-reveal>
        <div class="way__top"><span class="way__badge">{m.selo}</span></div>
        <Moldura nome={m.foto.img} alt={m.foto.alt} sizes="(max-width: 900px) 100vw, 44vw" />
        <div class="way__body">
          <h3>{m.titulo}</h3>
          <p>{m.texto}</p>
          <dl>{m.linhas.map(([a, b]) => <div><dt>{a}</dt><dd>{Array.isArray(b) ? b.map((linha, i) => <>{i > 0 && <br />}{linha}</>) : b}</dd></div>)}</dl>
          <div class="actions"><Botao href={m.botao.href} variante={m.botao.variante}>{m.botao.texto}</Botao></div>
        </div>
      </article>
    ))}
  </section>

  <Momentos titulo="Como é a consulta" id="h-etapas" />

  <section class="composer" aria-labelledby="h-mensagem">
    <div class="wrap grid">
      <div class="composer__head">
        <Kicker data-reveal>CONCIERGE DIGITAL</Kicker>
        <h2 id="h-mensagem" data-reveal>Monte sua mensagem</h2>
        <p class="composer__intro" data-reveal style="--i:1">Escolha a consulta, a unidade e o que você está sentindo. A mensagem fica pronta para enviar pelo WhatsApp, e a equipe responde com os horários e o valor.</p>
      </div>
      <form class="composer__form" data-composer={site.whats} data-spotlight>
        {escolhas.map((c) => (
          <fieldset>
            <legend>{c.legenda}</legend>
            <div class="choices">{c.opcoes.map((o) => <label><input type="radio" name={c.nome} value={o} checked={o === c.marcada} /><span>{o}</span></label>)}</div>
          </fieldset>
        ))}
        <div class="composer__preview" aria-live="polite">
          <span class="composer__preview-label">MENSAGEM PRONTA PARA ENVIO</span>
          <p data-message>{site.msgEquipe}</p>
        </div>
        <div><Botao href={wa(site.msgEquipe)} data-send target="_blank" rel="noopener">Enviar pelo WhatsApp</Botao></div>
      </form>
    </div>
  </section>

  <section class="places wrap grid" aria-labelledby="h-unidades">
    <div class="places__head">
      <Kicker data-reveal>ENDEREÇOS EXCLUSIVOS</Kicker>
      <h2 id="h-unidades" data-reveal>Onde atendemos</h2>
    </div>
    <figure class="places__pic"><Moldura nome="avenida-copacabana" alt="A Avenida Nossa Senhora de Copacabana, com prédios e árvores dos dois lados" sizes="(max-width: 900px) 84vw, 34vw" /><figcaption>Avenida Nossa Senhora de Copacabana</figcaption></figure>
    <div class="places__list" data-reveal>
      {site.unidades.map((u) => (
        <div class="place" data-spotlight><Kicker>{u.coords}</Kicker><h3>{u.nome}</h3><p>{u.rua}<br />{u.bairro}</p><a class="link" href={u.mapa} rel="noopener">Como chegar &rarr;</a></div>
      ))}
      <div class="place place--dark" data-spotlight><Kicker ouro>EXPANSÃO • 2027</Kicker><h3>Março de 2027</h3><p>A nova Hair Zenith abre as portas. Até lá, os atendimentos seguem nestes dois endereços.</p><a class="link" href="/nova-clinica/">A nova clínica &rarr;</a></div>
    </div>
  </section>

  <Perguntas itens={faq} />
  <Fecho frase="Agende pelo WhatsApp e receba os horários das duas consultas." pergunta="Pronto para agendar?" />
</Base>
