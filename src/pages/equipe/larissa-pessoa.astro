---
import Base from '../../layouts/Base.astro';
import Phero from '../../components/Phero.astro';
import Dividida from '../../components/Dividida.astro';
import Passos from '../../components/Passos.astro';
import Faixa from '../../components/Faixa.astro';
import Fecho from '../../components/Fecho.astro';
import Botao from '../../components/Botao.astro';
import { site, wa, doi } from '../../lib/site';
import { LARISSA_ID, migalhas, schemaLarissa, schemaArtigos } from '../../lib/schema';

const artigos = site.artigos.map((a) => ({
  nome: a.titulo,
  texto: `${a.autores.join(', ')}. Brazilian Journal of Hair Health, v. 2, n. 1, 2025. <a class="link" href="${doi(a.doi)}" rel="noopener">doi.org/${a.doi} &#8599;</a>`,
}));
const schema = [
  schemaLarissa(),
  { '@type': 'ProfilePage', url: site.url + '/equipe/larissa-pessoa/', mainEntity: { '@id': LARISSA_ID } },
  migalhas([['Hair Zenith', '/'], ['Equipe', '/equipe/'], ['Larissa Pessoa', '/equipe/larissa-pessoa/']]),
  ...schemaArtigos(),
];
---
<Base
  titulo="Larissa Pessoa, fundadora da Hair Zenith e tricologista no Rio de Janeiro"
  descricao="Larissa Pessoa é tricologista, fundadora e CEO da Hair Zenith, clínica especializada em queda de cabelo e calvície no Rio de Janeiro. Antes, Larissa Pessoa Tricologia Integrativa."
  ativo="equipe"
  schema={schema}
  imagem="larissa-blazer"
  tipo="profile"
>
  <Phero
    h1="Larissa Pessoa"
    lead="Fundadora e CEO da Hair Zenith. Tricologista especializada em queda de cabelo e calvície."
    alto={{ img: 'larissa-blazer', alt: 'Larissa Pessoa de blazer branco, com a mão no rosto' }}
    quadrado={{ img: 'larissa-rosa-retrato', alt: 'Retrato de Larissa Pessoa de vestido rosé' }}
  >
    <Botao href={wa(site.msgLarissa)}>Agendar com Larissa</Botao><a class="link" href="/consulta/">As duas consultas &rarr;</a>
  </Phero>
  <Dividida titulo="Da clínica com o seu nome à Hair Zenith" foto={{ img: 'larissa-sentada', alt: 'Larissa Pessoa sorri sentada em uma poltrona clara' }} id="h-trajetoria">
    <p class="lead">Por anos, a clínica levou o nome dela: Larissa Pessoa Tricologia Integrativa, em Copacabana e Cabo Frio.</p>
    <p>O consultório cresceu, a equipe também, e o método que Larissa desenvolveu passou a ser conduzido por outras tricologistas. A Hair Zenith é a forma desse crescimento: uma clínica com estrutura, equipe e nome próprios, fundada e dirigida por ela.</p>
    <p>Quem procura por Larissa Pessoa continua encontrando Larissa Pessoa. Ela segue atendendo, agora dentro da Hair Zenith, na Consulta com Larissa Pessoa.</p>
  </Dividida>
  <Faixa titulo="Uma história com a queda" foto={{ img: 'larissa-rosa', alt: 'Larissa Pessoa de vestido rosé em uma sala clara' }} id="h-historia">
    <p>Larissa já passou pela queda de cabelo. Conhece de perto o efeito dela na autoestima, e é isso que orienta o jeito como cada consulta é conduzida: tempo para ouvir, explicação clara de cada achado e acompanhamento próximo.</p>
    <p>É também o que explica a escolha de trabalhar só com um assunto. Queda e calvície, em mulheres e homens, sem cirurgia.</p>
    <Fragment slot="acoes"><Botao href={wa(site.msgLarissa)} variante="gold">Agendar com Larissa</Botao></Fragment>
  </Faixa>
  <Dividida titulo="Publicações" foto={{ img: 'cowper-1698', alt: 'Gravura de 1698 com cortes de pele e folículos capilares ampliados' }} id="h-publicacoes" inverte>
    <p class="lead">Dois estudos de caso sobre alopecia androgenética, escritos com a equipe da clínica e a Faculdade de Farmácia da UFRJ.</p>
    <Passos itens={artigos} />
  </Dividida>
  <Fecho frase="A Consulta com Larissa Pessoa tem agenda própria e valor diferenciado." pergunta="Quer ser atendido por Larissa?" retrato={{ img: 'larissa-rosa-retrato', alt: 'Retrato de Larissa Pessoa de vestido rosé' }} />
</Base>
