---
import Kicker from './Kicker.astro';
import Moldura from './Moldura.astro';
import type { Imagem } from '../lib/site';

interface Props {
  titulo: [string, string];
  linhas: { nome: string; texto: string }[];
  foto: Imagem;
  id?: string;
}
const { titulo, linhas, foto, id = 'h-sinais' } = Astro.props;
---
<section class="signs signs--page wrap" aria-labelledby={id}>
  <div class="signs__header">
    <Kicker data-reveal>SINAIS CLÍNICOS DE ALERTA</Kicker>
    <h2 id={id} class="head" data-reveal><span class="indent">{titulo[0]}</span> <em>{titulo[1]}</em></h2>
  </div>
  <div class="signs__body grid">
    <figure class="signs__map signs__pic"><Moldura nome={foto.img} alt={foto.alt} sizes="(max-width: 900px) 80vw, 34vw" /></figure>
    <div class="signs__table">
      {linhas.map((l, i) => (
        <div class="trow" data-spotlight data-reveal style={`--i:${i}`}>
          <span class="trow__idx">0{i + 1}</span>
          <p class="trow__name">{l.nome}</p>
          <p class="trow__text">{l.texto}</p>
        </div>
      ))}
    </div>
  </div>
</section>
