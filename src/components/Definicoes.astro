---
import Kicker from './Kicker.astro';
import Moldura from './Moldura.astro';
import type { Imagem } from '../lib/site';

interface Props {
  titulo: string;
  intro: string;
  itens: { nome: string; texto: string }[];
  foto: Imagem;
  id?: string;
  kicker?: string;
}
const { titulo, intro, itens, foto, id = 'h-def', kicker = 'FUNDAMENTAÇÃO CLÍNICA' } = Astro.props;
---
<section class="defs wrap grid" aria-labelledby={id}>
  <div class="defs__header">
    <Kicker data-reveal>{kicker}</Kicker>
    <h2 id={id} data-reveal>{titulo}</h2>
    <p class="defs__intro" data-reveal style="--i:1">{intro}</p>
    {Astro.slots.has('acoes') && <div class="actions" data-reveal style="--i:2"><slot name="acoes" /></div>}
  </div>
  <dl class="defs__list">
    {itens.map((it, i) => (
      <div class="defs__card" data-spotlight data-reveal style={`--i:${i % 2}`}>
        <span class="defs__num">0{i + 1}</span>
        <dt>{it.nome}</dt><dd>{it.texto}</dd>
      </div>
    ))}
  </dl>
  <figure class="defs__pic"><Moldura nome={foto.img} alt={foto.alt} sizes="(max-width: 900px) 70vw, 28vw" /></figure>
</section>
