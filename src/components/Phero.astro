---
// Abertura das páginas internas: título, texto, ações (slot) e duas fotos.
import Kicker from './Kicker.astro';
import Moldura from './Moldura.astro';
import type { Imagem } from '../lib/site';

interface Props {
  h1: string | string[];
  lead: string;
  texto?: string;
  alto: Imagem;
  quadrado: Imagem;
  id?: string;
}
const { h1, lead, texto, alto, quadrado, id = 'titulo' } = Astro.props;
const linhas = Array.isArray(h1) ? h1 : [h1];
---
<section class="phero wrap grid" aria-labelledby={id}>
  <div class="phero__main">
    <Kicker data-load style="--d:120ms">HAIR ZENITH • ALTA TRICOLOGIA</Kicker>
    <h1 id={id} class="lines">{linhas.map((l, i) => <span class="line"><span data-line style={`--i:${i}`}>{l}</span></span>)}</h1>
    <div class="phero__text">
      <p class="lead" data-load style="--d:320ms">{lead}</p>
      {texto && <p data-load style="--d:400ms">{texto}</p>}
      <div class="actions" data-load style="--d:480ms"><slot /></div>
    </div>
  </div>
  <div class="phero__visuals">
    <figure class="phero__tall"><Moldura nome={alto.img} alt={alto.alt} sizes="(max-width: 900px) 78vw, 34vw" attrs={{ 'data-shutter': '' }} prioridade /></figure>
    <figure class="phero__small"><Moldura nome={quadrado.img} alt={quadrado.alt} sizes="(max-width: 900px) 45vw, 18vw" attrs={{ 'data-load': '', style: '--d:580ms' }} /></figure>
  </div>
</section>
