---
// Faixa escura: texto no slot padrão, botões no slot "acoes" e uma foto.
import Kicker from './Kicker.astro';
import Moldura from './Moldura.astro';
import type { Imagem } from '../lib/site';

interface Props {
  titulo: string;
  foto: Imagem;
  id?: string;
}
const { titulo, foto, id = 'h-faixa' } = Astro.props;
---
<section class="band" aria-labelledby={id}>
  <div class="wrap grid">
    <div class="band__content">
      <Kicker ouro data-reveal>DIAGNÓSTICO DE ALTA PRECISÃO</Kicker>
      <h2 id={id} data-reveal>{titulo}</h2>
      <div class="band__text" data-reveal style="--i:1"><slot /></div>
      <div class="actions" data-reveal style="--i:2"><slot name="acoes" /></div>
    </div>
    <figure class="band__pic"><Moldura nome={foto.img} alt={foto.alt} sizes="(max-width: 900px) 84vw, 38vw" /></figure>
  </div>
</section>
