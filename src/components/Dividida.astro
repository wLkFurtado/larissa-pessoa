---
// Título à esquerda (com foto opcional) e o corpo, passado no slot, à direita.
import Kicker from './Kicker.astro';
import Moldura from './Moldura.astro';
import type { Imagem } from '../lib/site';

interface Props {
  titulo: string;
  foto?: Imagem;
  id?: string;
  inverte?: boolean;
}
const { titulo, foto, id = 'h-div', inverte = false } = Astro.props;
---
<section class={inverte ? 'split wrap grid split--flip' : 'split wrap grid'} aria-labelledby={id}>
  <div class="split__head">
    <Kicker data-reveal>ABORDAGEM TERAPÊUTICA</Kicker>
    <h2 id={id} data-reveal>{titulo}</h2>
    {foto && <figure class="split__fig"><Moldura nome={foto.img} alt={foto.alt} sizes="(max-width: 900px) 84vw, 34vw" /></figure>}
  </div>
  <div class="split__body" data-reveal style="--i:1"><slot /></div>
</section>
